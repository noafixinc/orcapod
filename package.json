{
  "name": "orcapod",
  "private": true,
  "version": "0.0.0",
  "description": "Watch GitHub issue and pull request labels and launch AI CLIs in Orca.",
  "license": "MIT",
  "author": {
    "name": "Noafix, Inc",
    "url": "https://noafix.com"
  },
  "homepage": "https://github.com/noafixinc/orcapod#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/noafixinc/orcapod.git"
  },
  "bugs": {
    "url": "https://github.com/noafixinc/orcapod/issues"
  },
  "type": "module",
  "bin": {
    "orcapod": "bin/orcapod.js"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node bin/orcapod.js up",
    "daemon": "node bin/orcapod.js start",
    "stop": "node bin/orcapod.js stop",
    "monitor": "node bin/orcapod.js monitor",
    "status": "node bin/orcapod.js status",
    "logs": "node bin/orcapod.js logs -f",
    "validate": "node bin/orcapod.js validate",
    "doctor": "node bin/orcapod.js doctor",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
